# ============================================================
# 纸盒 · AI 操作手机 —— Android 工程
# ============================================================

# ---------- 构建产物（可重建） ----------
build/
app/build/
.gradle/
.kotlin/
captures/
.externalNativeBuild/
.cxx/

# 工程内自带的 Gradle 缓存（约 320M）。
# 放在工程里是因为本机文件沙箱只允许写工作区，默认的 ~/.gradle 写不进去。
# 它纯粹是缓存，删掉下次构建会重新下。
.gradle-home/

# ---------- 本地配置 ----------
# 含机器专属的 SDK 路径，不该共享
local.properties

# ---------- IDE / 系统 ----------
.idea/
*.iml
.DS_Store

# ---------- 临时文件 ----------
*.log
*.tmp
*~

# ---------- 二进制参考资料（体积大，不入库）----------
# docs/reference/ 下的 roubao 源码 zip 和 APK
*.apk
*.zip
