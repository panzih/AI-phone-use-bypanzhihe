android-app/.gradle/
android-app/.pyinstaller_cache/

# Gradle 缓存
.gradle/

# 本地配置：含机器专属的 SDK 路径，不该共享
local.properties

# ---------- 系统和 IDE ----------
.DS_Store
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/

# ---------- 临时文件 ----------
*.log
*.tmp
*~
