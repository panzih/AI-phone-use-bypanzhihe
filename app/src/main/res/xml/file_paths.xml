<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider 暴露给外部的路径白名单。

  只开两个目录，不多开：
    exports/         导出的 zip（缓存目录，系统可随时清）
    纸盒/logs/        原始日志（私有目录）

  分享时通过它把 file:// 换成 content:// —— 直接传 file:// 在
  Android 7 以上会抛 FileUriExposedException。
-->
<paths>
    <cache-path
        name="exports"
        path="exports/" />

    <!--
      下载好的更新包。直接 file:// 传给系统安装器在 Android 7 以上会抛
      FileUriExposedException，所以走 FileProvider 换成 content://。
    -->
    <cache-path
        name="updates"
        path="updates/" />

    <!--
      内置浏览器里点网页上的下载链接，落在这里。和上面的更新包分开：
      更新包每次只留一个、会被清掉，网页下载不该被它误删。
    -->
    <cache-path
        name="downloads"
        path="downloads/" />

    <files-path
        name="logs"
        path="纸盒/logs/" />
</paths>
