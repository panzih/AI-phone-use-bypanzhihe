<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider 暴露给外部的路径白名单。

  只开两个目录，不多开：
    exports/         导出的 zip（缓存目录，系统可随时清）
    纸盒/logs/        原始日志（私有目录）

  分享时通过它把 file:// 换成 content:// —— 直接传 file:// 在
  Android 7 以上会抛 FileUriExposedException。
-->
<paths>
    <cache-path
        name="exports"
        path="exports/" />

    <!--
      内置浏览器里点网页上的下载链接，落在这里。
      0.17.0 起不再有应用内更新，原来那个 `updates/` 目录已经去掉。
    -->
    <cache-path
        name="downloads"
        path="downloads/" />

    <files-path
        name="logs"
        path="纸盒/logs/" />
</paths>
