<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      联网权限。要调模型 API，没有它连 socket 都建不起来。

      这是普通权限（normal），装上就有，不需要运行时申请。
      没有它的表现是连接直接失败，而且报错不会说"你没给权限"。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      悬浮窗权限：AI 操作期间的顶部状态卡和底部急停按钮。

      这是**特殊权限**，不是运行时权限 —— 必须跳系统设置页让用户手动开，
      代码申请不了。没开的话悬浮窗加不上去，任务退化成"看不到进度"。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      前台服务：悬浮窗要在用户切到别的应用之后继续存在，
      就必须挂在 Service 上，而 Service 要被系统保活就得是前台服务。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      通知权限（Android 13+）。前台服务的常驻通知里带了「急停」按钮，
      用户拒绝通知权限的话按钮就没了 —— 但悬浮窗上的急停还在。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      包可见性声明（Android 11 / API 30 起必需）。

      从 Android 11 开始，queryIntentActivities() 这类"查别人装了什么"的
      接口默认是**被过滤的**：不声明 <queries> 的话，你只能看到自己和
      少数几个包。表现极其隐蔽 —— 不报错、不抛异常，就是列表很短。

      这里声明"我要看所有有桌面入口的应用"，覆盖两处：
        - list_apps 技能：拿应用列表和包名
        - open_app 动作：getLaunchIntentForPackage() 也属于被过滤的查询接口，
          拿不到就会返回 null，日志里只会说"没找到这个包"

      用 <queries> 而不是 QUERY_ALL_PACKAGES 权限：前者是声明式的最小范围，
      不需要申请任何权限；后者是敏感权限，上架要额外说明用途。
    -->
    <!--
      定时任务的两个权限。

      SCHEDULE_EXACT_ALARM：Android 12 起"精确闹钟"要单独授权，
      而且 **Android 14 默认是拒绝的**（用户得去系统设置里允许）。
      拿不到时 Scheduler 会退回不精确闹钟（可能晚几分钟），
      界面上会显示当前是哪种并提供授权入口 —— 不会静默失效。

      RECEIVE_BOOT_COMPLETED：闹钟在重启后会被系统清空，
      必须在开机广播里重新登记，否则用户设的定时任务重启一次就没了。
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AiPhoneAssistant">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AiPhoneAssistant"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          副屏的"窗口"。

          单独一个 Activity 是因为用户要的是"像视频号那样独立弹出来的窗口"。
          它本身不做任何操作，只是把 shell 截到的副屏画面贴出来。
        -->
        <activity
            android:name=".display.MirrorActivity"
            android:exported="false"
            android:label="@string/vd_title"
            android:theme="@style/Theme.AiPhoneAssistant" />

        <!--
          日志导出用的 FileProvider。

          authority 必须和 LogExporter 里拼的一致（<包名>.fileprovider）。
          exported=false + grantUriPermissions=true 是标准组合：
          不对外暴露，只把分享出去的那一个 Uri 临时授权读取。

          没有它，分享日志会在 Android 7 以上抛 FileUriExposedException。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          悬浮控制面板。

          foregroundServiceType 在 Android 14+ 是**必填**的，不写会直接崩。
          用 specialUse 是因为它既不是定位也不是播放，是"AI 操作期间的
          悬浮控制面板"；property 里要写清楚用途，这是上架审核会看的。
        -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="AI 操作手机期间显示进度与急停按钮的悬浮控制面板" />
        </service>

        <!--
          Shizuku 的 binder 提供者。

          注册它之后 Shizuku 才能把特权进程的 binder 交给本应用。
          authority 必须写成「<包名>.shizuku」（Shizuku 库会按这个规则找），
          permission 是 Shizuku 官方要求的，exported 必须为 true
          —— 因为 binder 是**跨进程**递过来的，不导出就收不到。

          没装 Shizuku 也不影响其它功能：这个 provider 只是注册在那，
          不会主动拉起任何东西。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
          定时任务到点的触发点。

          **不导出**：闹钟是我们自己用 PendingIntent 登记的显式广播，
          不需要外面能发进来。导出一个"能触发任务"的入口没有必要，
          而攻击面是实打实的。
        -->
        <receiver
            android:name=".schedule.ScheduleReceiver"
            android:exported="false" />

        <!--
          开机后重新登记定时任务（闹钟在重启时会被系统清空）。

          这个**必须导出** —— 开机广播是系统发的，不导出收不到。
          它不接收任何参数，只做重排，所以没有可利用的面。
        -->
        <receiver
            android:name=".schedule.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          核心无障碍服务。

          permission 必须是 BIND_ACCESSIBILITY_SERVICE，这是系统绑定的凭据。
          exported=true 也是必须的 —— 系统要能跨应用绑定它。

          meta-data 指向配置文件，里面声明了服务的能力
          （能不能截图、能不能做手势、要不要读控件树）。

          注意：这个服务是**常驻**的，用户授权后重启手机也会自动恢复 ——
          这正是选无障碍而不是 Shizuku 的主要原因。
        -->
        <service
            android:name=".a11y.AutoService"
            android:exported="true"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
