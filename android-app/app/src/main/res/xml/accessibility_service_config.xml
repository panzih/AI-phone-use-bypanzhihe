<?xml version="1.0" encoding="utf-8"?>
<!--
  无障碍服务的配置。

  几个关键项的解释：

  accessibilityEventTypes
      订阅哪些事件。本项目是"轮询截图"模式，不靠事件驱动，
      但还是订阅了窗口变化 —— 以后要做"等界面稳定"的自适应等待会用到。

  accessibilityFlags
      flagReportViewIds   带上控件 id，调试和精确定位都要
      flagRetrieveInteractiveWindows  能拿到多个窗口（比如弹窗在上面）
      flagIncludeNotImportantViews    很多界面的关键控件被标成"不重要"，
                                      不带上就会漏，宁可多过滤也别漏

  canPerformGestures
      允许 dispatchGesture。**多指手势（双指缩放）靠它**，ADB 方案做不到。
      也是长按、滑动、按坐标点击的基础。

  canTakeScreenshot
      API 30+ 才认这个属性。允许 takeScreenshot。

  canRetrieveWindowContent
      读控件树的开关，**这个项目的定位能力全靠它**，必须为 true。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/a11y_service_description"
    android:summary="@string/a11y_service_summary"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:notificationTimeout="100"
    android:settingsActivity="com.aiphone.assistant.MainActivity" />
