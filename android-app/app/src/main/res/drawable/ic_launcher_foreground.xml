<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标前景：手机轮廓 + 中间一个点，呼应"AI 在操作这台手机"。
  用矢量图，不需要多套位图，任何分辨率都清晰。
  画布按自适应图标规范是 108x108，实际可见区域是中间 72x72。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 手机外框 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:fillColor="#00000000"
        android:strokeLineJoin="round"
        android:pathData="M42,30 L66,30 A5,5 0 0 1 71,35 L71,73 A5,5 0 0 1 66,78 L42,78 A5,5 0 0 1 37,73 L37,35 A5,5 0 0 1 42,30 Z" />

    <!-- 屏幕中间的操作点 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,48 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />

    <!-- 底部指示点 -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.65"
        android:pathData="M54,71 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0" />
</vector>
